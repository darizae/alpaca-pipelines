# Absolute path to the persistence root containing audio_collection_* directories.
# Example shape:
#   /abs/path/to/raw_audio_collection
# Must contain:
#   audio_collection_1/
#   audio_collection_2/
ALPACA_COLLECTION_ROOT=/absolute/path/to/raw_audio_collection

# Absolute path to merged_index.json under ALPACA_COLLECTION_ROOT.
# Must point to:
#   ${ALPACA_COLLECTION_ROOT}/merged_index.json
ALPACA_MERGED_INDEX=/absolute/path/to/raw_audio_collection/merged_index.json

# Absolute path to the datasets root directory.
# Datasets live at:
#   ${ALPACA_DATASETS_ROOT}/<strategy_name>/
# containing:
#   manifest.json
#   snippets/
#   splits/{train,val,test}.csv
ALPACA_DATASETS_ROOT=/absolute/path/to/datasets_root

# Absolute path to alpaca-pipelines' own runs/work root.
# alpaca-pipelines writes orchestration artifacts here (job specs, status JSON, log pointers, output pointers).
# This MUST NOT be inside the audio persistence root; keep it separate.
ALPACA_RUNS_ROOT=/absolute/path/to/alpaca_runs_root
