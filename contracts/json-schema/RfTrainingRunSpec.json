{
  "$defs": {
    "RfFeatureConfig": {
      "additionalProperties": false,
      "properties": {
        "sample_rate_hz": {
          "default": 48000,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "min_duration_s": {
          "default": 0.4,
          "title": "Min Duration S",
          "type": "number"
        },
        "pad_short_segments": {
          "default": true,
          "title": "Pad Short Segments",
          "type": "boolean"
        },
        "pad_mode": {
          "const": "constant",
          "default": "constant",
          "title": "Pad Mode",
          "type": "string"
        },
        "n_fft": {
          "default": 2048,
          "title": "N Fft",
          "type": "integer"
        },
        "hop_length": {
          "default": 1024,
          "title": "Hop Length",
          "type": "integer"
        },
        "n_mfcc": {
          "default": 13,
          "title": "N Mfcc",
          "type": "integer"
        },
        "include_deltas": {
          "default": true,
          "title": "Include Deltas",
          "type": "boolean"
        },
        "fmin_hz": {
          "default": 0.0,
          "title": "Fmin Hz",
          "type": "number"
        },
        "fmax_hz": {
          "default": 4000.0,
          "title": "Fmax Hz",
          "type": "number"
        }
      },
      "title": "RfFeatureConfig",
      "type": "object"
    }
  },
  "description": "Complete specification for an RF training run.",
  "properties": {
    "dataset_name": {
      "title": "Dataset Name",
      "type": "string"
    },
    "run_name": {
      "default": "",
      "title": "Run Name",
      "type": "string"
    },
    "positive_class": {
      "default": "target",
      "title": "Positive Class",
      "type": "string"
    },
    "random_state": {
      "default": 1337,
      "title": "Random State",
      "type": "integer"
    },
    "n_estimators": {
      "default": 400,
      "title": "N Estimators",
      "type": "integer"
    },
    "max_depth": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Depth"
    },
    "min_samples_split": {
      "default": 2,
      "title": "Min Samples Split",
      "type": "integer"
    },
    "min_samples_leaf": {
      "default": 1,
      "title": "Min Samples Leaf",
      "type": "integer"
    },
    "max_features": {
      "anyOf": [
        {
          "enum": [
            "sqrt",
            "log2"
          ],
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": "sqrt",
      "title": "Max Features"
    },
    "class_weight": {
      "anyOf": [
        {
          "enum": [
            "balanced",
            "balanced_subsample"
          ],
          "type": "string"
        },
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": "balanced",
      "title": "Class Weight"
    },
    "n_jobs": {
      "default": -1,
      "title": "N Jobs",
      "type": "integer"
    },
    "rf_threshold": {
      "default": 0.4,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Rf Threshold",
      "type": "number"
    },
    "feature_config": {
      "$ref": "#/$defs/RfFeatureConfig"
    }
  },
  "required": [
    "dataset_name"
  ],
  "title": "RfTrainingRunSpec",
  "type": "object"
}
