{
  "$defs": {
    "NormalizationSpec": {
      "additionalProperties": false,
      "description": "Normalization parameters for prediction.",
      "properties": {
        "mode": {
          "default": "db",
          "enum": [
            "db",
            "min_max"
          ],
          "title": "Mode",
          "type": "string"
        },
        "min_level_db": {
          "default": -100,
          "title": "Min Level Db",
          "type": "number"
        },
        "ref_level_db": {
          "default": 20,
          "title": "Ref Level Db",
          "type": "number"
        }
      },
      "title": "NormalizationSpec",
      "type": "object"
    },
    "RfFeatureConfig": {
      "additionalProperties": false,
      "properties": {
        "sample_rate_hz": {
          "default": 48000,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "min_duration_s": {
          "default": 0.5,
          "title": "Min Duration S",
          "type": "number"
        },
        "pad_short_segments": {
          "default": true,
          "title": "Pad Short Segments",
          "type": "boolean"
        },
        "pad_mode": {
          "const": "constant",
          "default": "constant",
          "title": "Pad Mode",
          "type": "string"
        },
        "n_fft": {
          "default": 4096,
          "title": "N Fft",
          "type": "integer"
        },
        "hop_length": {
          "default": 2048,
          "title": "Hop Length",
          "type": "integer"
        },
        "n_mfcc": {
          "default": 13,
          "title": "N Mfcc",
          "type": "integer"
        },
        "include_deltas": {
          "default": true,
          "title": "Include Deltas",
          "type": "boolean"
        },
        "fmin_hz": {
          "default": 50.0,
          "title": "Fmin Hz",
          "type": "number"
        },
        "fmax_hz": {
          "default": 4500.0,
          "title": "Fmax Hz",
          "type": "number"
        }
      },
      "title": "RfFeatureConfig",
      "type": "object"
    },
    "TapeFileHandleSpec": {
      "additionalProperties": false,
      "properties": {
        "collection_name": {
          "title": "Collection Name",
          "type": "string"
        },
        "category_dir": {
          "title": "Category Dir",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        }
      },
      "required": [
        "collection_name",
        "category_dir",
        "relative_path"
      ],
      "title": "TapeFileHandleSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete specification for a prediction run.",
  "properties": {
    "training_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Run Id"
    },
    "model_path": {
      "title": "Model Path",
      "type": "string"
    },
    "mode": {
      "default": "tape",
      "enum": [
        "tape",
        "dataset",
        "collection"
      ],
      "title": "Mode",
      "type": "string"
    },
    "tape_files": {
      "items": {
        "$ref": "#/$defs/TapeFileHandleSpec"
      },
      "title": "Tape Files",
      "type": "array"
    },
    "dataset_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Name"
    },
    "collection_names": {
      "items": {
        "type": "string"
      },
      "title": "Collection Names",
      "type": "array"
    },
    "source_category_dirs": {
      "items": {
        "type": "string"
      },
      "title": "Source Category Dirs",
      "type": "array"
    },
    "sequence_length_ms": {
      "default": 400,
      "title": "Sequence Length Ms",
      "type": "integer"
    },
    "hop_ms": {
      "default": 50,
      "title": "Hop Ms",
      "type": "integer"
    },
    "batch_size": {
      "default": 16,
      "title": "Batch Size",
      "type": "integer"
    },
    "num_workers": {
      "default": 4,
      "title": "Num Workers",
      "type": "integer"
    },
    "use_cuda": {
      "default": true,
      "title": "Use Cuda",
      "type": "boolean"
    },
    "normalization": {
      "$ref": "#/$defs/NormalizationSpec"
    },
    "detection_threshold": {
      "default": 0.5,
      "title": "Detection Threshold",
      "type": "number"
    },
    "merge_overlapping": {
      "default": true,
      "title": "Merge Overlapping",
      "type": "boolean"
    },
    "min_detection_duration_s": {
      "default": 0.0,
      "title": "Min Detection Duration S",
      "type": "number"
    },
    "apply_rf_filter": {
      "default": false,
      "title": "Apply Rf Filter",
      "type": "boolean"
    },
    "rf_training_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rf Training Run Id"
    },
    "rf_model_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rf Model Path"
    },
    "rf_threshold": {
      "default": 0.4,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Rf Threshold",
      "type": "number"
    },
    "rf_feature_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/RfFeatureConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_name": {
      "default": "",
      "title": "Run Name",
      "type": "string"
    }
  },
  "required": [
    "model_path"
  ],
  "title": "PredictionRunSpec",
  "type": "object"
}
